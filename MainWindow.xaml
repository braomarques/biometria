<Window x:Class="Biometrica.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Autenticação Biométrica - APS" Height="550" Width="800"
        Closing="Window_Closing">
    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <GroupBox Header="Câmera Ao Vivo" Grid.Column="0" Margin="5" FontWeight="Bold">
            <Image x:Name="CameraImage" Stretch="Uniform" />
        </GroupBox>

        <StackPanel Grid.Column="1" Margin="15" VerticalAlignment="Center">
            <TextBlock Text="Controles Biométricos" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,30"/>
            
            <Button x:Name="BtnCadastrar" Content="📸 1. Cadastrar Meu Rosto" Padding="12" Margin="0,5" Background="LightBlue" FontWeight="Bold" Click="BtnCadastrar_Click"/>
            <Button x:Name="BtnAutenticar" Content="🔐 2. Fazer Login (Validar)" Padding="12" Margin="0,15,0,5" Background="LightGreen" FontWeight="Bold" Click="BtnAutenticar_Click"/>
            
            <Border Background="#f0f0f0" Padding="10" Margin="0,30,0,0" CornerRadius="5">
                <StackPanel>
                    <TextBlock Text="Status do Sistema:" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBlock x:Name="TxtStatus" Text="Iniciando câmera e carregando modelos neurais..." TextWrapping="Wrap" Foreground="DarkSlateBlue" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>

